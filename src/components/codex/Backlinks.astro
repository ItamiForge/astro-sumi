---
import { Icon } from '@/components/Icon'
import type { CodexBacklink } from '@/lib/content/world'
import { withBase } from '@/lib/utils/url'

interface Props {
  links: CodexBacklink[]
}

const { links } = Astro.props
---

{
  links.length > 0 && (
    <section class="space-y-3">
      <h2 class="flex items-center gap-2 text-xl font-medium">
        <Icon name="book-open" className="size-4" />
        Mentioned in
      </h2>
      <ul class="space-y-2 text-sm">
        {links.map((link) => (
          <li>
            <a class="hover:text-primary" href={withBase(link.href)}>
              {link.title}
            </a>
            <span class="text-muted-foreground"> · {link.kicker}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}
