---
import { getWikiCardIndex } from '@/lib/content/world'

const cards = await getWikiCardIndex()
const payload = JSON.stringify(cards).replace(/</g, '\\u003c')
---

<script is:inline id="wiki-index" type="application/json" set:html={payload} />

<div
  id="wiki-hover"
  class="wiki-hover pointer-events-none fixed z-50 hidden w-72 rounded-xl border p-3 shadow-lg"
  role="tooltip"
>
  <div class="flex gap-3">
    <div
      id="wiki-hover-monogram"
      class="flex size-12 shrink-0 items-center justify-center rounded-md text-lg font-medium"
    >
    </div>
    <div class="min-w-0">
      <p
        id="wiki-hover-kicker"
        class="text-muted-foreground text-xs tracking-wide uppercase"
      >
      </p>
      <p id="wiki-hover-name" class="font-medium"></p>
      <p
        id="wiki-hover-bio"
        class="text-muted-foreground mt-1 line-clamp-4 text-sm"
      >
      </p>
    </div>
  </div>
</div>

<script>
  import { accentFromSlug } from '@/lib/wiki/parse'

  type WikiCard = {
    kind: string
    slug: string
    name: string
    kicker?: string
    shortBio: string
    href: string
  }

  document.addEventListener('astro:page-load', () => {
    const source = document.getElementById('wiki-index')
    const hover = document.getElementById('wiki-hover')
    if (!source || !hover) return

    let cards: WikiCard[] = []
    try {
      cards = JSON.parse(source.textContent || '[]') as WikiCard[]
    } catch {
      return
    }

    const kicker = document.getElementById('wiki-hover-kicker')
    const name = document.getElementById('wiki-hover-name')
    const bio = document.getElementById('wiki-hover-bio')
    const monogram = document.getElementById('wiki-hover-monogram')

    const findCard = (kind: string, slug: string) =>
      cards.find(
        (card) => card.slug === slug && (!kind || card.kind === kind),
      ) ?? cards.find((card) => card.slug === slug)

    let hideTimer: number | undefined

    const hide = () => {
      hover.classList.add('hidden')
    }

    const show = (link: HTMLElement) => {
      const kind = link.getAttribute('data-wiki-kind') || ''
      const slug = link.getAttribute('data-wiki-slug') || ''
      const card = findCard(kind, slug)
      if (!card || !kicker || !name || !bio || !monogram) return

      kicker.textContent = card.kicker || kind
      name.textContent = card.name
      bio.textContent = card.shortBio
      monogram.textContent = card.name.charAt(0).toUpperCase()
      const accent = accentFromSlug(card.slug)
      monogram.style.background = accent.background
      monogram.style.color = accent.foreground

      hover.classList.remove('hidden')
      const rect = link.getBoundingClientRect()
      const top = rect.bottom + 8
      const left = Math.min(rect.left, window.innerWidth - 300)
      hover.style.top = `${Math.min(top, window.innerHeight - hover.offsetHeight - 12)}px`
      hover.style.left = `${Math.max(12, left)}px`
    }

    document.querySelectorAll<HTMLElement>('.wiki-link').forEach((link) => {
      link.addEventListener('mouseenter', () => {
        window.clearTimeout(hideTimer)
        show(link)
      })
      link.addEventListener('focus', () => {
        window.clearTimeout(hideTimer)
        show(link)
      })
      link.addEventListener('mouseleave', () => {
        hideTimer = window.setTimeout(hide, 120)
      })
      link.addEventListener('blur', () => {
        hideTimer = window.setTimeout(hide, 120)
      })
    })
  })
</script>

<style>
  .wiki-hover {
    background: var(--background);
    border-color: var(--border);
  }
</style>
