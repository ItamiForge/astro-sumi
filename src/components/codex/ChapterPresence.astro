---
import type { WikiCard } from '@/lib/content/world'
import CodexCard from './CodexCard.astro'

interface Props {
  title?: string
  cards: WikiCard[]
}

const { title = 'In this chapter', cards } = Astro.props
---

{
  cards.length > 0 && (
    <section class="mb-8">
      <h2 class="mb-4 text-lg font-medium">{title}</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        {cards.map((card) => (
          <CodexCard card={card} />
        ))}
      </div>
    </section>
  )
}
