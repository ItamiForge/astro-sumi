---
import { Icon } from '@/components/Icon'
import Link from '@/components/Link.astro'
import { Button } from '@/components/ui/button'
import { NAV_LINKS, SITE } from '@/consts'
import { withBase } from '@/lib/utils/url'

const current = Astro.url.pathname.replace(/\/$/, '') || '/'
const homePath = withBase('/').replace(/\/$/, '') || '/'
---

<div class="masthead">
  <div
    class="container-responsive flex flex-wrap items-center justify-between gap-4 py-4"
  >
    <Link href="/" class="flex min-w-0 items-baseline gap-3">
      <span
        class="font-serif text-2xl leading-none font-semibold tracking-tight sm:text-3xl"
      >
        {SITE.title}
      </span>
      <span
        class="text-muted-foreground hidden max-w-xs text-xs leading-snug sm:block"
      >
        A template for serials, a Codex, and maps.
      </span>
    </Link>
    <div class="flex items-center gap-4">
      <nav class="editorial-nav hidden items-center gap-5 md:flex">
        {
          NAV_LINKS.map((item) => {
            const href = withBase(item.href).replace(/\/$/, '')
            const active =
              href === homePath
                ? current === homePath
                : current === href || current.startsWith(`${href}/`)
            return (
              <Link href={item.href} aria-current={active ? 'page' : undefined}>
                {item.label}
              </Link>
            )
          })
        }
      </nav>
      <nav class="editorial-nav flex items-center gap-3 text-sm md:hidden">
        {
          NAV_LINKS.slice(0, 3).map((item) => (
            <Link href={item.href}>{item.label}</Link>
          ))
        }
      </nav>
      <Button
        id="reading-settings-toggle"
        variant="ghost"
        size="icon"
        title="Appearance"
        className="-my-2 -me-2 size-8"
        aria-haspopup="dialog"
        aria-controls="reading-settings"
      >
        <Icon name="settings" className="size-4" />
        <span class="sr-only">Appearance settings</span>
      </Button>
    </div>
  </div>
</div>
