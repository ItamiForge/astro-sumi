---
import PaperNoirBackground from '@/components/PaperNoirBackground'
---

<div class="paper-noir-bg" aria-hidden="true">
  <PaperNoirBackground client:only="react" />
</div>

<style>
  .paper-noir-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: var(--background);
    opacity: 0.12;
  }

  @media (prefers-reduced-motion: reduce) {
    .paper-noir-bg {
      opacity: 0;
    }
  }
</style>
