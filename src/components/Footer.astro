---
import { Separator } from '@/components/ui/separator'
import { SITE, SOCIAL_LINKS } from '@/consts'
import Link from './Link.astro'
import SocialIcons from './SocialIcons.astro'

const githubLink = SOCIAL_LINKS.find((link) => link.label === 'GitHub')?.href
---

<footer class="bg-background text-foreground relative z-10 border-t">
  <div
    class="container-responsive flex flex-col items-center justify-center gap-y-2 py-5 sm:flex-row sm:justify-between"
  >
    <div class="flex flex-wrap items-center justify-center gap-x-2 text-center">
      <span class="text-sm">
        &copy; {new Date().getFullYear()} All rights reserved.
      </span>
      <Separator orientation="vertical" className="hidden h-4! sm:block" />
      <p class="text-sm">
        Made with <span class="text-primary" aria-hidden="true">♥</span> by {
          githubLink ? (
            <Link href={githubLink} class="text-foreground" external underline>
              {SITE.author}
            </Link>
          ) : (
            <span>{SITE.author}</span>
          )
        }!
      </p>
    </div>
    <SocialIcons links={SOCIAL_LINKS} />
  </div>
</footer>
