---
import { Icon } from '@/components/Icon'
import { Button } from '@/components/ui/button'
import { PALETTES, TYPE_PAIRINGS } from '@/lib/appearance'
---

<!-- Body-level overlay so position:fixed is not clipped by the sticky header. -->
<div
  id="reading-settings"
  class="bg-background/80 fixed inset-0 z-[80] hidden items-center justify-center p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="reading-settings-title"
>
  <div
    class="bg-background max-h-[min(36rem,calc(100dvh-2rem))] w-full max-w-md overflow-y-auto rounded-xl border p-5 shadow-lg"
  >
    <div class="mb-4 flex items-center justify-between">
      <h2 id="reading-settings-title" class="font-medium">Appearance</h2>
      <Button
        id="reading-settings-close"
        variant="ghost"
        size="icon"
        aria-label="Close appearance settings"
      >
        <Icon name="x" className="size-4" />
      </Button>
    </div>

    <div class="space-y-5 text-sm">
      <fieldset class="space-y-2">
        <legend class="text-muted-foreground text-xs tracking-wide uppercase">
          Palette
        </legend>
        <div class="grid grid-cols-2 gap-2" data-reading-group="palette">
          {
            PALETTES.map((palette) => (
              <button
                type="button"
                class="reading-chip palette-chip"
                data-value={palette.id}
              >
                <span
                  class="palette-swatch"
                  style={`background:${palette.swatch};color:${palette.ink}`}
                  aria-hidden="true"
                />
                {palette.name}
              </button>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="space-y-2">
        <legend class="text-muted-foreground text-xs tracking-wide uppercase">
          Type
        </legend>
        <div
          class="grid grid-cols-1 gap-2 sm:grid-cols-2"
          data-reading-group="type"
        >
          {
            TYPE_PAIRINGS.map((pairing) => (
              <button
                type="button"
                class="reading-chip type-card"
                data-value={pairing.id}
              >
                <span
                  class="type-card-aa"
                  style={`font-family:${pairing.previewFamily}`}
                  aria-hidden="true"
                >
                  Aa
                </span>
                <span class="type-card-copy">
                  <span class="type-card-name">{pairing.name}</span>
                  <span class="type-card-sample">{pairing.sample}</span>
                </span>
              </button>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="space-y-2">
        <legend class="text-muted-foreground text-xs tracking-wide uppercase">
          Type size
        </legend>
        <div class="flex flex-wrap gap-2" data-reading-group="size">
          <button type="button" class="reading-chip" data-value="sm">S</button>
          <button type="button" class="reading-chip" data-value="md">M</button>
          <button type="button" class="reading-chip" data-value="lg">L</button>
          <button type="button" class="reading-chip" data-value="xl">XL</button>
        </div>
      </fieldset>

      <fieldset class="space-y-2">
        <legend class="text-muted-foreground text-xs tracking-wide uppercase">
          Measure
        </legend>
        <div class="flex flex-wrap gap-2" data-reading-group="measure">
          <button type="button" class="reading-chip" data-value="narrow"
            >Narrow</button
          >
          <button type="button" class="reading-chip" data-value="default"
            >Default</button
          >
          <button type="button" class="reading-chip" data-value="wide"
            >Wide</button
          >
        </div>
      </fieldset>

      <fieldset class="space-y-2">
        <legend class="text-muted-foreground text-xs tracking-wide uppercase">
          Leading
        </legend>
        <div class="flex flex-wrap gap-2" data-reading-group="leading">
          <button type="button" class="reading-chip" data-value="snug"
            >Snug</button
          >
          <button type="button" class="reading-chip" data-value="default"
            >Default</button
          >
          <button type="button" class="reading-chip" data-value="loose"
            >Loose</button
          >
        </div>
      </fieldset>

      <fieldset class="space-y-2">
        <legend class="text-muted-foreground text-xs tracking-wide uppercase">
          Spoilers
        </legend>
        <div class="flex flex-wrap gap-2" data-reading-group="reader">
          <button type="button" class="reading-chip" data-value="first-time"
            >First-time</button
          >
          <button type="button" class="reading-chip" data-value="scholar"
            >Scholar</button
          >
        </div>
      </fieldset>

      <fieldset class="space-y-2">
        <legend class="text-muted-foreground text-xs tracking-wide uppercase">
          Chrome
        </legend>
        <div class="flex flex-wrap gap-2" data-reading-group="immersive">
          <button type="button" class="reading-chip" data-value="false"
            >Full site</button
          >
          <button type="button" class="reading-chip" data-value="true"
            >Immersive</button
          >
        </div>
      </fieldset>
    </div>
  </div>
</div>

<script>
  import {
    applyPalette,
    applyTypePairing,
    DEFAULT_PALETTE,
    DEFAULT_TYPE,
    isPalette,
    isTypePairing,
    restoreAppearance,
  } from '@/lib/appearance'
  import {
    applyImmersive,
    applyReaderMode,
    applyReadingLeading,
    applyReadingMeasure,
    applyReadingSize,
    DEFAULT_LEADING,
    DEFAULT_MEASURE,
    DEFAULT_READER,
    DEFAULT_SIZE,
    isReaderMode,
    isReadingLeading,
    isReadingMeasure,
    isReadingSize,
    READING_KEYS,
    restoreReadingPrefs,
    storedOrDefault,
  } from '@/lib/reading'

  const GROUPS = [
    'palette',
    'type',
    'size',
    'measure',
    'leading',
    'reader',
    'immersive',
  ] as const

  function currentValue(group: (typeof GROUPS)[number]) {
    if (group === 'palette') {
      return storedOrDefault(READING_KEYS.palette, isPalette, DEFAULT_PALETTE)
    }
    if (group === 'type') {
      return storedOrDefault(READING_KEYS.type, isTypePairing, DEFAULT_TYPE)
    }
    if (group === 'size') {
      return storedOrDefault(READING_KEYS.size, isReadingSize, DEFAULT_SIZE)
    }
    if (group === 'measure') {
      return storedOrDefault(
        READING_KEYS.measure,
        isReadingMeasure,
        DEFAULT_MEASURE,
      )
    }
    if (group === 'leading') {
      return storedOrDefault(
        READING_KEYS.leading,
        isReadingLeading,
        DEFAULT_LEADING,
      )
    }
    if (group === 'reader') {
      return storedOrDefault(READING_KEYS.reader, isReaderMode, DEFAULT_READER)
    }
    return localStorage.getItem(READING_KEYS.immersive) === 'true'
      ? 'true'
      : 'false'
  }

  function markPressed(group: string, value: string) {
    document
      .querySelectorAll(`[data-reading-group="${group}"] .reading-chip`)
      .forEach((chip) => {
        chip.setAttribute(
          'aria-pressed',
          chip.getAttribute('data-value') === value ? 'true' : 'false',
        )
      })
  }

  function apply(group: (typeof GROUPS)[number], value: string) {
    if (group === 'palette') applyPalette(value)
    else if (group === 'type') applyTypePairing(value)
    else if (group === 'size') applyReadingSize(value)
    else if (group === 'measure') applyReadingMeasure(value)
    else if (group === 'leading') applyReadingLeading(value)
    else if (group === 'reader') applyReaderMode(value)
    else applyImmersive(value === 'true')
    markPressed(group, value)
  }

  function initReadingSettings() {
    const panel = document.getElementById('reading-settings')
    const toggle = document.getElementById('reading-settings-toggle')
    const close = document.getElementById('reading-settings-close')
    if (!panel || !toggle || !close) return

    const open = () => {
      panel.classList.remove('hidden')
      panel.classList.add('flex')
      close.focus()
    }
    const hide = () => {
      panel.classList.add('hidden')
      panel.classList.remove('flex')
      toggle.focus()
    }

    toggle.addEventListener('click', open)
    close.addEventListener('click', hide)
    panel.addEventListener('click', (event) => {
      if (event.target === panel) hide()
    })

    const onKey = (event: KeyboardEvent) => {
      if (event.key !== 'Escape' || panel.classList.contains('hidden')) return
      event.preventDefault()
      hide()
    }
    document.addEventListener('keydown', onKey)
    document.addEventListener(
      'astro:before-swap',
      () => document.removeEventListener('keydown', onKey),
      { once: true },
    )

    for (const group of GROUPS) {
      markPressed(group, currentValue(group))
      document
        .querySelectorAll(`[data-reading-group="${group}"] .reading-chip`)
        .forEach((chip) => {
          chip.addEventListener('click', () => {
            const value = chip.getAttribute('data-value')
            if (value) apply(group, value)
          })
        })
    }
  }

  restoreAppearance()
  restoreReadingPrefs()
  initReadingSettings()
  document.addEventListener('astro:after-swap', () => {
    restoreAppearance()
    restoreReadingPrefs()
    initReadingSettings()
  })
</script>

<style>
  .reading-chip {
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    padding: 0.4rem 0.75rem;
    background: var(--background);
    color: var(--foreground);
  }

  .reading-chip[aria-pressed='true'] {
    background: var(--primary);
    color: var(--primary-foreground);
    border-color: var(--primary);
    font-weight: 500;
  }

  .palette-chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: flex-start;
  }

  .palette-swatch {
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklch, var(--foreground) 25%, transparent);
    flex-shrink: 0;
  }

  .type-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-align: left;
  }

  .type-card-aa {
    font-size: 1.35rem;
    line-height: 1;
    font-weight: 600;
  }

  .type-card-copy {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .type-card-sample {
    font-size: 0.7rem;
    opacity: 0.75;
  }
</style>
