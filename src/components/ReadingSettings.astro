---
import { Icon } from '@/components/Icon'
import { Button } from '@/components/ui/button'
import { PRESET_GROUPS, presetsInGroup } from '@/lib/appearance'

const groupLabel = {
  comfort: 'Reading comfort',
  world: 'Story worlds',
} as const
---

<!-- Body-level overlay so position:fixed is not clipped by the sticky header. -->
<div
  id="reading-settings"
  class="bg-background/80 fixed inset-0 z-[80] hidden items-center justify-center p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="reading-settings-title"
>
  <div
    class="bg-background max-h-[min(40rem,calc(100dvh-2rem))] w-full max-w-lg overflow-y-auto rounded-xl border p-5 shadow-lg"
  >
    <div class="mb-4 flex items-center justify-between">
      <div>
        <h2 id="reading-settings-title" class="font-serif font-medium">Look</h2>
        <p class="text-muted-foreground mt-1 text-xs">
          One preset for color, type, size, and corners.
        </p>
      </div>
      <Button
        id="reading-settings-close"
        variant="ghost"
        size="icon"
        aria-label="Close appearance settings"
      >
        <Icon name="x" className="size-4" />
      </Button>
    </div>

    <div class="space-y-5 text-sm">
      {
        PRESET_GROUPS.map((group) => (
          <fieldset class="space-y-2">
            <legend class="text-muted-foreground text-xs tracking-wide uppercase">
              {groupLabel[group]}
            </legend>
            <div class="grid gap-2" data-reading-group="preset">
              {presetsInGroup(group).map((preset) => (
                <button
                  type="button"
                  class="reading-chip preset-card"
                  data-value={preset.id}
                >
                  <span
                    class="palette-swatch"
                    style={`background:${preset.swatch};color:${preset.ink}`}
                    aria-hidden="true"
                  />
                  <span class="preset-copy">
                    <span class="preset-name">{preset.name}</span>
                    <span class="preset-blurb">{preset.blurb}</span>
                  </span>
                </button>
              ))}
            </div>
          </fieldset>
        ))
      }

      <fieldset class="space-y-2">
        <legend class="text-muted-foreground text-xs tracking-wide uppercase">
          Spoilers
        </legend>
        <div class="flex flex-wrap gap-2" data-reading-group="reader">
          <button type="button" class="reading-chip" data-value="first-time"
            >First-time</button
          >
          <button type="button" class="reading-chip" data-value="scholar"
            >Scholar</button
          >
        </div>
      </fieldset>
    </div>
  </div>
</div>

<script>
  import {
    applyPreset,
    DEFAULT_PRESET,
    isPreset,
    restoreAppearance,
    storedPresetId,
  } from '@/lib/appearance'
  import {
    applyReaderMode,
    DEFAULT_READER,
    isReaderMode,
    READING_KEYS,
    restoreReadingPrefs,
    storedOrDefault,
  } from '@/lib/reading'

  const GROUPS = ['preset', 'reader'] as const

  function currentValue(group: (typeof GROUPS)[number]) {
    if (group === 'preset') return storedPresetId()
    return storedOrDefault(READING_KEYS.reader, isReaderMode, DEFAULT_READER)
  }

  function markPressed(group: string, value: string) {
    document
      .querySelectorAll(`[data-reading-group="${group}"] .reading-chip`)
      .forEach((chip) => {
        chip.setAttribute(
          'aria-pressed',
          chip.getAttribute('data-value') === value ? 'true' : 'false',
        )
      })
  }

  function apply(group: (typeof GROUPS)[number], value: string) {
    if (group === 'preset') {
      applyPreset(isPreset(value) ? value : DEFAULT_PRESET)
    } else {
      applyReaderMode(value)
    }
    markPressed(group, value)
  }

  function initReadingSettings() {
    const panel = document.getElementById('reading-settings')
    const toggle = document.getElementById('reading-settings-toggle')
    const close = document.getElementById('reading-settings-close')
    if (!panel || !toggle || !close) return

    const open = () => {
      panel.classList.remove('hidden')
      panel.classList.add('flex')
      close.focus()
    }
    const hide = () => {
      panel.classList.add('hidden')
      panel.classList.remove('flex')
      toggle.focus()
    }

    toggle.addEventListener('click', open)
    close.addEventListener('click', hide)
    panel.addEventListener('click', (event) => {
      if (event.target === panel) hide()
    })

    const onKey = (event: KeyboardEvent) => {
      if (event.key !== 'Escape' || panel.classList.contains('hidden')) return
      event.preventDefault()
      hide()
    }
    document.addEventListener('keydown', onKey)
    document.addEventListener(
      'astro:before-swap',
      () => document.removeEventListener('keydown', onKey),
      { once: true },
    )

    for (const group of GROUPS) {
      markPressed(group, currentValue(group))
      document
        .querySelectorAll(`[data-reading-group="${group}"] .reading-chip`)
        .forEach((chip) => {
          chip.addEventListener('click', () => {
            const value = chip.getAttribute('data-value')
            if (value) apply(group, value)
          })
        })
    }
  }

  restoreAppearance()
  restoreReadingPrefs()
  initReadingSettings()
  document.addEventListener('astro:after-swap', () => {
    restoreAppearance()
    restoreReadingPrefs()
    initReadingSettings()
  })
</script>

<style is:global>
  #reading-settings .reading-chip {
    border: 1px solid var(--border);
    border-radius: var(--shape-lg);
    padding: 0.5rem 0.75rem;
    background: var(--background);
    color: var(--foreground);
    text-align: left;
  }

  #reading-settings .reading-chip[aria-pressed='true'] {
    background: var(--primary);
    color: var(--primary-foreground);
    border-color: var(--primary);
    font-weight: 500;
  }

  #reading-settings .preset-card {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  #reading-settings .palette-swatch {
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.15rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklch, var(--foreground) 25%, transparent);
    flex-shrink: 0;
  }

  #reading-settings .preset-copy {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  #reading-settings .preset-name {
    font-weight: 550;
  }

  #reading-settings .preset-blurb {
    font-size: 0.75rem;
    line-height: 1.35;
    opacity: 0.8;
  }
</style>
