---
/**
 * Blocking boot script: apply the stored look preset before first paint.
 * Maps come from appearance.ts so the allow-list cannot drift.
 */
import { SITE } from '@/consts'
import {
  DEFAULT_PRESET,
  LEGACY_APPEARANCE_KEYS,
  LEGACY_PALETTE_TO_PRESET,
  PRESET_IDS,
  PRESET_READING,
  PRESET_SCHEMES,
} from '@/lib/appearance'
import { DEFAULT_READER, READER_MODES, READING_KEYS } from '@/lib/reading'
import { withBase } from '@/lib/utils/url'
import { ClientRouter } from 'astro:transitions'
import Favicons from './Favicons.astro'
---

<head>
  <script
    is:inline
    define:vars={{
      PRESET_SCHEMES,
      PRESET_IDS,
      PRESET_READING,
      DEFAULT_PRESET,
      DEFAULT_READER,
      READING_KEYS,
      LEGACY_APPEARANCE_KEYS,
      LEGACY_PALETTE_TO_PRESET,
      READER_MODES,
    }}
  >
    ;(() => {
      const root = document.documentElement
      const pick = (value, allowed, fallback) =>
        allowed.includes(value) ? value : fallback
      try {
        let preset = localStorage.getItem(READING_KEYS.preset) || ''
        if (!PRESET_IDS.includes(preset)) {
          const type = localStorage.getItem('sumi:type') || ''
          const palette = localStorage.getItem('sumi:palette') || ''
          preset =
            type === 'clear'
              ? 'clear'
              : LEGACY_PALETTE_TO_PRESET[palette] || DEFAULT_PRESET
        }
        const scheme = PRESET_SCHEMES[preset] || PRESET_SCHEMES[DEFAULT_PRESET]
        const reading = PRESET_READING[preset] || PRESET_READING[DEFAULT_PRESET]
        const reader = pick(
          localStorage.getItem(READING_KEYS.reader) || '',
          READER_MODES,
          DEFAULT_READER,
        )
        const immersive =
          localStorage.getItem(READING_KEYS.immersive) === 'true'
        root.setAttribute('data-preset', preset)
        root.setAttribute('data-theme', scheme)
        root.style.colorScheme = scheme
        root.setAttribute('data-reading-size', reading.size)
        root.setAttribute('data-reading-measure', reading.measure)
        root.setAttribute('data-reading-leading', reading.leading)
        root.setAttribute('data-reader', reader)
        if (immersive) root.setAttribute('data-immersive', '')
        else root.removeAttribute('data-immersive')
        for (const key of LEGACY_APPEARANCE_KEYS) {
          localStorage.removeItem(key)
        }
      } catch {
        root.setAttribute('data-preset', DEFAULT_PRESET)
        root.setAttribute('data-theme', PRESET_SCHEMES[DEFAULT_PRESET])
        const reading = PRESET_READING[DEFAULT_PRESET]
        if (reading) {
          root.setAttribute('data-reading-size', reading.size)
          root.setAttribute('data-reading-measure', reading.measure)
          root.setAttribute('data-reading-leading', reading.leading)
        }
      }
    })()
  </script>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, user-scalable=yes"
  />
  <meta name="generator" content={Astro.generator} />

  <meta name="HandheldFriendly" content="True" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta
    name="format-detection"
    content="telephone=no,date=no,address=no,email=no,url=no"
  />

  <meta
    name="theme-color"
    content="#121212"
    media="(prefers-color-scheme: dark)"
  />
  <meta
    name="theme-color"
    content="#f7f1e6"
    media="(prefers-color-scheme: light)"
  />

  <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
  <link rel="manifest" href={withBase('/site.webmanifest')} />
  <link
    rel="alternate"
    type="application/rss+xml"
    title={SITE.title}
    href={new URL('rss.xml', Astro.site)}
  />

  <Favicons />
  <ClientRouter />

  <slot />
</head>
