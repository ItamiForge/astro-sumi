---
import '@/styles/global.css'
import '@/styles/performance.css'
import '@/styles/typography.css'

import WikiHover from '@/components/codex/WikiHover.astro'
import FontStyles from '@/components/FontStyles.astro'
import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import Header from '@/components/Header.astro'
import KeyboardHelp from '@/components/KeyboardHelp.astro'
import ReadingSettings from '@/components/ReadingSettings.astro'
import { SITE } from '@/consts'
import { DEFAULT_PRESET, presetById } from '@/lib/appearance'
import { cn } from '@/lib/utils'

interface Props {
  class?: string
  containerType?: 'responsive' | 'reading' | 'wide' | 'fluid'
}

const { class: className, containerType = 'responsive' } = Astro.props
const containerClass = `container-${containerType}`
const defaultPreset = presetById(DEFAULT_PRESET)
---

<!doctype html>
<html
  class="bg-background text-foreground"
  lang={SITE.locale}
  data-preset={DEFAULT_PRESET}
  data-theme={defaultPreset.scheme}
  data-reading-size={defaultPreset.reading.size}
  data-reading-measure={defaultPreset.reading.measure}
  data-reading-leading={defaultPreset.reading.leading}
>
  <Head>
    <slot name="head" />
  </Head>
  <FontStyles />
  <body class="flex h-fit min-h-screen flex-col gap-y-6 font-sans">
    <!-- Fixed overlays stay outside this header: transform makes it a containing block. -->
    <header
      class="bg-background/90 sticky top-0 z-50 divide-y backdrop-blur-sm xl:divide-none"
      style="will-change: transform; transform: translateZ(0);"
    >
      <Header />
      <slot name="subposts-navigation" />
      <slot name="table-of-contents" />
    </header>
    <main class={cn(containerClass, 'flex grow flex-col gap-y-6', className)}>
      <slot />
    </main>
    <WikiHover />
    <ReadingSettings />
    <KeyboardHelp />
    <Footer />
  </body>
</html>
