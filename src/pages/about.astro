---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
---

<Layout containerType="wide">
  <PageHead slot="head" title="About" />

  <Breadcrumbs items={[{ label: 'About', icon: 'lucide:info' }]} />

  <section class="bg-background font-body rounded-lg border">
    <div class="flex flex-col space-y-1.5 p-6">
      <h3 class="text-3xl leading-none font-medium">{SITE.title}</h3>
      <p class="text-muted-foreground text-sm">Novel Writing Template</p>
    </div>
    <div class="space-y-4 p-6 pt-0">
      <p class="text-muted-foreground text-sm">
        {SITE.title} is a clean, minimal template specifically designed for novel
        and book writing projects. Built with <Link
          href="https://astro.build"
          class="text-foreground"
          external
          underline>Astro</Link
        >, <Link
          href="https://tailwindcss.com"
          class="text-foreground"
          external
          underline>Tailwind</Link
        >, and <Link
          href="https://ui.shadcn.com"
          class="text-foreground"
          external
          underline>shadcn/ui</Link
        >, it provides an excellent foundation for creative writers to showcase
        their work online.
      </p>
      <p class="text-muted-foreground text-sm">
        This template supports novels, volumes, and chapters, plus a Codex
        (people, places, glossary, maps, relics), wiki-links in the prose,
        reading settings, and continue-reading. Sample stories are examples to
        delete with <code class="bg-muted rounded px-1">bun run fresh</code> or rewrite
        in the
        <Link href="/admin/" class="text-foreground" underline>CMS</Link>.
      </p>
      <div class="pt-2">
        <h4 class="mb-2 text-lg font-medium">Attribution</h4>
        <p class="text-muted-foreground text-sm">
          This project is based on <Link
            href="https://github.com/jktrn/astro-erudite"
            class="text-foreground"
            external
            underline>astro-erudite</Link
          > by <Link
            href="https://github.com/jktrn"
            class="text-foreground"
            external
            underline>jktrn</Link
          >. It has been adapted and extended for novel and book writing
          workflows.
        </p>
      </div>
    </div>
  </section>
</Layout>
