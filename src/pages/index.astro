---
import ContinueReading from '@/components/ContinueReading.astro'
import { Icon } from '@/components/Icon'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import PaperNoirBackdrop from '@/components/PaperNoirBackdrop.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getAllNovels } from '@/lib/content/novels'
import { formatDate } from '@/lib/utils'
import { withBase } from '@/lib/utils/url'
import { Image } from 'astro:assets'

const novels = await getAllNovels()
const featured = novels[0]
const rail = novels.slice(1, 5)
---

<Layout containerType="wide">
  <PageHead slot="head" title="Home" />
  <PaperNoirBackdrop />

  <div class="issue-rule border-y py-3">
    <div class="editorial-cats flex flex-wrap items-center gap-x-5 gap-y-2">
      <span class="text-primary text-xs tracking-[0.16em]">[ Materials ]</span>
      <Link href="/novels">Novels</Link>
      <Link href="/codex">Codex</Link>
      <Link href="/codex/atlas">Atlas</Link>
      <Link href="/codex/glossary">Glossary</Link>
      <Link href="/codex/annals">Annals</Link>
      <Link href="/codex/library">Library</Link>
    </div>
  </div>

  <ContinueReading />

  {
    featured ? (
      <section class="fade-up grid gap-0 lg:grid-cols-[minmax(0,1.6fr)_minmax(16rem,1fr)]">
        <article class="lg:border-border min-w-0 lg:border-r lg:pr-10">
          <a
            href={withBase(`/novels/${featured.id}`)}
            class="hero-frame group block"
            transition:name="hero-art"
          >
            {featured.data.coverImage ? (
              <Image
                src={featured.data.coverImage}
                alt={featured.data.title}
                width={1200}
                height={640}
                class="aspect-[16/8] w-full object-cover"
              />
            ) : (
              <div class="hero-fallback bg-muted text-muted-foreground flex aspect-[16/8] items-center justify-center">
                <Icon name="book-open" className="size-16" />
              </div>
            )}
          </a>
          <p class="text-primary mt-5 text-xs tracking-[0.16em] uppercase">
            [ Novel ] · {featured.data.status}
            {featured.data.wordCount
              ? ` · ${featured.data.wordCount.toLocaleString()} words`
              : ''}
          </p>
          <div class="mt-3 grid gap-4 md:grid-cols-[1.2fr_0.8fr] md:items-start">
            <h1 class="font-serif text-4xl leading-[1.15] font-semibold lg:text-5xl">
              <Link href={`/novels/${featured.id}`}>{featured.data.title}</Link>
            </h1>
            <p class="text-muted-foreground text-sm leading-relaxed md:pt-2">
              {featured.data.description}
            </p>
          </div>
          <p class="text-muted-foreground mt-4 text-xs">
            {formatDate(featured.data.startDate)}
            {featured.data.genre?.length
              ? ` · ${featured.data.genre.slice(0, 2).join(' / ')}`
              : ''}
          </p>
        </article>

        <aside class="fade-up-delay mt-10 space-y-0 lg:mt-0 lg:pl-8">
          {rail.map((novel, index) => (
            <a
              href={withBase(`/novels/${novel.id}`)}
              class="hover:bg-muted/30 flex items-start gap-4 border-b py-5 first:pt-0 last:border-b-0"
            >
              <div class="min-w-0 flex-1">
                <p class="text-primary text-xs tracking-[0.14em] uppercase">
                  [ {novel.data.status} ] · {index + 2}
                </p>
                <h2 class="mt-2 font-serif text-xl leading-tight font-semibold">
                  {novel.data.title}
                </h2>
                <p class="text-muted-foreground mt-2 line-clamp-3 text-sm leading-relaxed">
                  {novel.data.description}
                </p>
              </div>
              {novel.data.coverImage && (
                <Image
                  src={novel.data.coverImage}
                  alt=""
                  width={160}
                  height={160}
                  class="hero-frame size-20 shrink-0 object-cover"
                />
              )}
            </a>
          ))}
          {novels.length > 5 && (
            <Link
              href="/novels"
              class="text-muted-foreground hover:text-foreground mt-4 inline-block text-sm"
            >
              All novels →
            </Link>
          )}
        </aside>
      </section>
    ) : (
      <section class="fade-up py-16">
        <p class="text-primary text-xs tracking-[0.16em] uppercase">
          [ Empty shelf ]
        </p>
        <h1 class="mt-3 font-serif text-4xl font-semibold">{SITE.title}</h1>
        <p class="text-muted-foreground mt-4 max-w-xl">
          Add a novel in{' '}
          <code class="bg-muted rounded px-1 text-sm">src/content/novels/</code>
          or open the{' '}
          <Link href="/admin/" underline>
            CMS
          </Link>
          . Run
          <code class="bg-muted rounded px-1 text-sm">bun run fresh</code>
          on a fork to clear the sample books first.
        </p>
      </section>
    )
  }
</Layout>
