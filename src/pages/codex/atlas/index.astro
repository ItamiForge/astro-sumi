---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import CodexCard from '@/components/codex/CodexCard.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllMaps } from '@/lib/content/world'

const maps = await getAllMaps()
const cards = maps.map((entry) => ({
  kind: 'map' as const,
  slug: entry.id,
  name: entry.data.name,
  kicker: entry.data.kind,
  shortBio: entry.data.shortBio,
  href: `/codex/atlas/${entry.id}`,
}))
---

<Layout containerType="wide">
  <PageHead
    slot="head"
    title="Atlas"
    description="Region plates and star charts for the worlds in this template."
  />
  <Breadcrumbs
    items={[
      { href: '/codex', label: 'Codex', icon: 'lucide:book-open' },
      { label: 'Atlas', icon: 'lucide:map' },
    ]}
  />
  <div class="space-y-3">
    <h1 class="text-3xl font-medium">Atlas</h1>
    <p class="text-muted-foreground max-w-2xl">
      Add a markdown file in <code class="bg-muted rounded px-1 text-sm"
        >src/content/maps/</code
      >
      and pin places with <code class="bg-muted rounded px-1 text-sm"
        >coords.map</code
      >. The valley below is sample content from Echoes of Eternity.
    </p>
  </div>
  {
    cards.length > 0 ? (
      <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
        {cards.map((card) => (
          <CodexCard card={card} />
        ))}
      </div>
    ) : (
      <p class="text-muted-foreground">
        No maps yet. Add one to start the atlas.
      </p>
    )
  }
</Layout>
