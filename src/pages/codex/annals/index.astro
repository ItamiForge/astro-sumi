---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import CodexCard from '@/components/codex/CodexCard.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllEvents } from '@/lib/content/world'
import { wikiHref } from '@/lib/wiki/parse'

const events = await getAllEvents()
const cards = events.map((entry) => ({
  kind: 'event' as const,
  slug: entry.id,
  name: entry.data.name,
  kicker: entry.data.date ?? entry.data.era ?? 'annal',
  shortBio: entry.data.shortBio,
  href: wikiHref('event', entry.id),
  visibility: entry.data.visibility,
}))
---

<Layout containerType="wide">
  <PageHead
    slot="head"
    title="Annals"
    description="A timeline of named events."
  />
  <Breadcrumbs
    items={[
      { href: '/codex', label: 'Codex', icon: 'lucide:book-open' },
      { label: 'Annals', icon: 'lucide:calendar' },
    ]}
  />
  <h1 class="font-serif text-3xl font-medium">Annals</h1>
  {
    cards.length === 0 ? (
      <p class="text-muted-foreground">
        No events yet. Add files under src/content/events/.
      </p>
    ) : (
      <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
        {cards.map((card) => (
          <CodexCard card={card} />
        ))}
      </div>
    )
  }
</Layout>
