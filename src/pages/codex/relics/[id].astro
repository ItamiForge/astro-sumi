---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import Backlinks from '@/components/codex/Backlinks.astro'
import Monogram from '@/components/codex/Monogram.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import {
  backlinksForSlug,
  getAllRelics,
  getCharacterById,
  getLocationById,
} from '@/lib/content/world'
import { withBase } from '@/lib/utils/url'
import { wikiHref } from '@/lib/wiki/parse'
import { render } from 'astro:content'

export async function getStaticPaths() {
  const relics = await getAllRelics()
  return relics.map((relic) => ({
    params: { id: relic.id },
    props: { relic },
  }))
}

const { relic } = Astro.props
const { Content } = await render(relic)
const links = await backlinksForSlug(relic.id, 'relic')
const origin = relic.data.origin
  ? await getLocationById(relic.data.origin)
  : null
const bearers = (
  await Promise.all(
    (relic.data.bearers ?? []).map((id) => getCharacterById(id)),
  )
).filter(Boolean)
---

<Layout containerType="wide">
  <PageHead
    slot="head"
    title={relic.data.name}
    description={relic.data.shortBio}
  />
  <Breadcrumbs
    items={[
      { href: '/codex', label: 'Codex', icon: 'lucide:book-open' },
      { href: '/codex/relics', label: 'Relics', icon: 'lucide:swords' },
      { label: relic.data.name, icon: 'lucide:swords' },
    ]}
  />

  <div class="grid gap-8 lg:grid-cols-[280px_1fr]">
    <aside class="space-y-4">
      <Monogram
        name={relic.data.name}
        slug={relic.id}
        class="h-40 w-full text-5xl"
      />
      <div class="bg-muted/30 space-y-3 rounded-lg p-4 text-sm">
        <p class="capitalize">{relic.data.kind}</p>
        {
          relic.data.era && (
            <p class="text-muted-foreground">{relic.data.era}</p>
          )
        }
        {
          origin && (
            <p>
              <span class="text-muted-foreground">Origin · </span>
              <a
                class="hover:text-primary"
                href={withBase(wikiHref('location', origin.id))}
              >
                {origin.data.name}
              </a>
            </p>
          )
        }
      </div>
    </aside>
    <div class="space-y-8">
      <div>
        <h1 class="font-serif text-3xl font-medium lg:text-4xl">
          {relic.data.name}
        </h1>
        <p class="text-muted-foreground mt-3 text-lg">{relic.data.shortBio}</p>
      </div>
      <article class="reading-content">
        <Content />
      </article>
      {
        bearers.length > 0 && (
          <section class="space-y-3">
            <h2 class="text-xl font-medium">Bearers</h2>
            <ul class="space-y-2 text-sm">
              {bearers.map(
                (person) =>
                  person && (
                    <li>
                      <a
                        class="hover:text-primary font-medium"
                        href={withBase(wikiHref('character', person.id))}
                      >
                        {person.data.name}
                      </a>
                    </li>
                  ),
              )}
            </ul>
          </section>
        )
      }
      <Backlinks links={links} />
    </div>
  </div>
</Layout>
