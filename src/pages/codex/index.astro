---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import CodexCard from '@/components/codex/CodexCard.astro'
import { Icon } from '@/components/Icon'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import {
  getAllCharacters,
  getAllFactions,
  getAllLocations,
  getAllSpecies,
} from '@/lib/content/world'
import { withBase } from '@/lib/utils/url'
import { wikiHref } from '@/lib/wiki/parse'

const characters = await getAllCharacters()
const locations = await getAllLocations()
const factions = await getAllFactions()
const species = await getAllSpecies()

const characterCards = characters.map((entry) => ({
  kind: 'character' as const,
  slug: entry.id,
  name: entry.data.name,
  kicker: entry.data.titles?.[0] ?? entry.data.role,
  shortBio: entry.data.shortBio,
  href: wikiHref('character', entry.id),
}))

const locationCards = locations.map((entry) => ({
  kind: 'location' as const,
  slug: entry.id,
  name: entry.data.name,
  kicker: entry.data.kind,
  shortBio: entry.data.shortBio,
  href: wikiHref('location', entry.id),
}))

const factionCards = factions.map((entry) => ({
  kind: 'faction' as const,
  slug: entry.id,
  name: entry.data.name,
  kicker: entry.data.kind,
  shortBio: entry.data.shortBio,
  href: wikiHref('faction', entry.id),
}))

const speciesCards = species.map((entry) => ({
  kind: 'species' as const,
  slug: entry.id,
  name: entry.data.name,
  kicker: 'kindred',
  shortBio: entry.data.shortBio,
  href: wikiHref('species', entry.id),
}))
---

<Layout containerType="wide">
  <PageHead
    slot="head"
    title="Codex"
    description="People, places, factions, and kindreds of the mythos."
  />

  <Breadcrumbs items={[{ label: 'Codex', icon: 'lucide:book-open' }]} />

  <section class="space-y-3">
    <h1 class="text-3xl font-medium lg:text-4xl">The Codex</h1>
    <p class="text-muted-foreground max-w-2xl text-lg">
      A gazetteer of the world beside the books. Cards are spoiler-safe. The
      story remains in the chapters.
    </p>
  </section>

  <nav class="flex flex-wrap gap-3 text-sm">
    <a href="#people" class="hover:text-primary text-foreground/70">People</a>
    <a href="#places" class="hover:text-primary text-foreground/70">Places</a>
    <a href="#factions" class="hover:text-primary text-foreground/70"
      >Factions</a
    >
    <a href="#kindreds" class="hover:text-primary text-foreground/70"
      >Kindreds</a
    >
  </nav>

  <section id="people" class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="flex items-center gap-2 text-2xl font-medium">
        <Icon name="users" className="size-5" />
        People
      </h2>
      <a
        href={withBase('/codex/people')}
        class="text-muted-foreground hover:text-primary text-sm"
      >
        All people
      </a>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
      {characterCards.slice(0, 6).map((card) => <CodexCard card={card} />)}
    </div>
  </section>

  <section id="places" class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="flex items-center gap-2 text-2xl font-medium">
        <Icon name="map-pin" className="size-5" />
        Places
      </h2>
      <a
        href={withBase('/codex/places')}
        class="text-muted-foreground hover:text-primary text-sm"
      >
        All places
      </a>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
      {locationCards.map((card) => <CodexCard card={card} />)}
    </div>
  </section>

  <section id="factions" class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="flex items-center gap-2 text-2xl font-medium">
        <Icon name="shield" className="size-5" />
        Factions
      </h2>
      <a
        href={withBase('/codex/factions')}
        class="text-muted-foreground hover:text-primary text-sm"
      >
        All factions
      </a>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
      {factionCards.map((card) => <CodexCard card={card} />)}
    </div>
  </section>

  <section id="kindreds" class="space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="flex items-center gap-2 text-2xl font-medium">
        <Icon name="sparkles" className="size-5" />
        Kindreds
      </h2>
      <a
        href={withBase('/codex/kindreds')}
        class="text-muted-foreground hover:text-primary text-sm"
      >
        All kindreds
      </a>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
      {speciesCards.map((card) => <CodexCard card={card} />)}
    </div>
  </section>
</Layout>
